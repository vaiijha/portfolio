---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projects } from "../data/resume";

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <SectionHeading class="mb-3 sm:mb-4">Projects</SectionHeading>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-4">
    {
      featuredProjects.map((p) => (
        <ProjectCard
          title={"cardTitle" in p && p.cardTitle ? p.cardTitle : p.title}
          subtitle={"cardSubtitle" in p ? p.cardSubtitle : undefined}
          desc={p.cardDesc}
          url={p.url}
          badge={p.badge}
          chips={[...p.chips]}
          featured={p.featured}
        />
      ))
    }
  </div>

  {
    otherProjects.length > 0 && (
      <div class="space-y-2">
        <p class="text-xs uppercase tracking-wide text-base-content/60 font-medium">Earlier work</p>
        {otherProjects.map((p) => (
          <ProjectCard
            title={"cardTitle" in p && p.cardTitle ? p.cardTitle : p.title}
            subtitle={"cardSubtitle" in p ? p.cardSubtitle : undefined}
            desc={p.cardDesc}
            url={p.url}
            badge={p.badge}
            chips={[...p.chips]}
            featured={p.featured}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
