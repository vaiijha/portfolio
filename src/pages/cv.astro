---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import {
  summary,
  skillCategories,
  experience,
  education,
  publications,
} from "../data/resume";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    {summary}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    {
      education.map((e) => (
        <TimeLineElement
          title={e.school}
          subtitle={`${e.dateRange} · ${e.location} · ${e.degree}`}
        >
          <ul class="list-disc pl-5 space-y-1">
            {e.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    {
      experience.map((job) => (
        <TimeLineElement
          title={job.title}
          subtitle={`${job.dateRange} · ${job.org} · ${job.location}`}
        >
          <ul class="list-disc pl-5 space-y-1">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </TimeLineElement>
      ))
    }
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Publications</div>
  </div>

  <ol class="list-decimal mx-6 mb-10 grid gap-2 pl-2">
    {publications.map((p) => <li class="text-justify">{p}</li>)}
  </ol>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-none mx-0 md:columns-2 gap-x-8 space-y-3">
    {
      skillCategories.map((cat) => (
        <li class="break-inside-avoid mb-3">
          <span class="font-semibold">{cat.label}:</span>{" "}
          <span>{cat.items}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
