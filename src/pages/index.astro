---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getCollection } from "astro:content";
import { person, roleLine, summary, projects } from "../data/resume";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const hasRealBlogPosts = posts.some(
  (post) =>
    !post.data.title.toLowerCase().includes("coming soon") &&
    post.data.badge?.toLowerCase() !== "soon"
);

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="hero-section mb-6 sm:mb-8">
    <p class="text-xs sm:text-sm uppercase tracking-widest text-base-content/50 mb-2">
      {person.location}
    </p>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-2">
      {person.name}
    </h1>

    <p class="text-base sm:text-lg font-medium text-primary leading-snug mb-3 max-w-prose">
      {roleLine}
    </p>

    <p class="text-sm sm:text-base text-base-content/75 leading-relaxed max-w-prose mb-5">
      {summary}
    </p>

    <div class="flex flex-wrap gap-2">
      <a class="btn btn-primary btn-sm" href={`mailto:${person.email}`}>Email</a>
      <a
        class="btn btn-outline btn-sm"
        href={person.urls.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        class="btn btn-outline btn-sm"
        href={person.urls.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a
        class="btn btn-outline btn-sm"
        href={person.urls.scholar}
        target="_blank"
        rel="noopener noreferrer"
      >
        Scholar
      </a>
    </div>
  </section>

  <section class="mb-8 sm:mb-10">
    <SectionHeading class="mb-3 sm:mb-4">Projects</SectionHeading>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
      {
        featuredProjects.map((p) => (
          <ProjectCard
            title={"cardTitle" in p && p.cardTitle ? p.cardTitle : p.title}
            subtitle={"cardSubtitle" in p ? p.cardSubtitle : undefined}
            desc={p.cardDesc}
            url={p.url}
            badge={p.badge}
            chips={[...p.chips]}
            featured={p.featured}
          />
        ))
      }
    </div>

    {
      otherProjects.length > 0 && (
        <div class="mt-3 sm:mt-4 space-y-2">
          <p class="text-xs uppercase tracking-wide text-base-content/60 font-medium">Earlier work</p>
          {otherProjects.map((p) => (
            <ProjectCard
              title={"cardTitle" in p && p.cardTitle ? p.cardTitle : p.title}
              subtitle={"cardSubtitle" in p ? p.cardSubtitle : undefined}
              desc={p.cardDesc}
              url={p.url}
              badge={p.badge}
              chips={[...p.chips]}
              featured={p.featured}
            />
          ))}
        </div>
      )
    }

    <p class="mt-3 text-sm text-base-content/55">
      <a href="/projects" class="link link-hover">View all projects →</a>
    </p>
  </section>

  {
    hasRealBlogPosts && (
      <section>
        <SectionHeading>Latest from blog</SectionHeading>
        <p class="text-base-content/70">Blog posts will appear here.</p>
      </section>
    )
  }
</BaseLayout>
