---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getCollection } from "astro:content";
import { person, roleLine, summary, projects } from "../data/resume";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const hasRealBlogPosts = posts.some(
  (post) =>
    !post.data.title.toLowerCase().includes("coming soon") &&
    post.data.badge?.toLowerCase() !== "soon"
);

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="hero-section mb-12 sm:mb-16">
    <p class="text-sm uppercase tracking-widest text-base-content/50 mb-3">
      {person.location}
    </p>

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight mb-3">
      {person.name}
    </h1>

    <p class="text-xl sm:text-2xl font-medium text-primary leading-snug mb-5 max-w-prose">
      {roleLine}
    </p>

    <p class="text-base sm:text-lg text-base-content/80 leading-relaxed max-w-prose mb-8">
      {summary}
    </p>

    <div class="flex flex-wrap gap-2 sm:gap-3">
      <a
        class="btn btn-primary btn-sm sm:btn-md"
        href={`mailto:${person.email}`}
      >
        Email
      </a>
      <a
        class="btn btn-outline btn-sm sm:btn-md"
        href={person.urls.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        class="btn btn-outline btn-sm sm:btn-md"
        href={person.urls.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a
        class="btn btn-outline btn-sm sm:btn-md"
        href={person.urls.scholar}
        target="_blank"
        rel="noopener noreferrer"
      >
        Scholar
      </a>
    </div>
  </section>

  <section class="mb-12 sm:mb-16">
    <SectionHeading>Projects</SectionHeading>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
      {
        featuredProjects.map((p) => (
          <ProjectCard
            title={p.title}
            desc={p.cardDesc}
            url={p.url}
            badge={p.badge}
            chips={[...p.chips]}
            featured={p.featured}
          />
        ))
      }
    </div>

    {
      otherProjects.length > 0 && (
        <div class="mt-4 sm:mt-5">
          {otherProjects.map((p) => (
            <ProjectCard
              title={p.title}
              desc={p.cardDesc}
              url={p.url}
              badge={p.badge}
              chips={[...p.chips]}
              featured={p.featured}
            />
          ))}
        </div>
      )
    }

    <p class="mt-4 text-sm text-base-content/60">
      <a href="/projects" class="link link-hover">View all projects →</a>
    </p>
  </section>

  {
    hasRealBlogPosts && (
      <section>
        <SectionHeading>Latest from blog</SectionHeading>
        <p class="text-base-content/70">Blog posts will appear here.</p>
      </section>
    )
  }
</BaseLayout>
