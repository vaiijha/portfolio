---
const {
  title,
  subtitle,
  desc,
  url,
  badge,
  chips = [],
  featured = true,
} = Astro.props;
const isLink = url && url !== "#";
const isInternal = isLink && url.startsWith("/");

const initials = title
  .split(/\s+/)
  .filter((w: string) => w.length > 2 && !/^\(/.test(w))
  .slice(0, 2)
  .map((w: string) => w[0])
  .join("")
  .toUpperCase();
---

<article
  class:list={[
    "card shadow-sm transition-shadow",
    featured
      ? "bg-base-200 border border-base-300 hover:shadow-md"
      : "earlier-work-card bg-base-200/90 border border-base-content/15 hover:shadow-sm",
  ]}
>
  <div class="card-body gap-2 p-3 sm:p-4">
    <div class="flex items-start gap-3">
      <div
        class:list={[
          "flex shrink-0 items-center justify-center rounded-md font-semibold",
          featured
            ? "h-9 w-9 text-xs bg-primary/15 text-primary"
            : "h-7 w-7 text-[10px] bg-base-300 text-base-content/75",
        ]}
        aria-hidden="true"
      >
        {initials}
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-start justify-between gap-x-2 gap-y-1">
          <div class="min-w-0">
            <h3
              class:list={[
                "font-semibold leading-snug",
                featured ? "text-base sm:text-lg" : "text-sm text-base-content/85",
              ]}
            >
              {title}
            </h3>
            {
              subtitle && (
                <p
                  class:list={[
                    "leading-snug mt-0.5",
                    featured
                      ? "text-xs sm:text-sm text-base-content/60"
                      : "text-xs text-base-content/55",
                  ]}
                >
                  {subtitle}
                </p>
              )
            }
          </div>
          {badge && (
            <span class="badge badge-ghost badge-xs sm:badge-sm whitespace-nowrap shrink-0">
              {badge}
            </span>
          )}
        </div>

        <p
          class:list={[
            "line-clamp-2 leading-snug mt-1",
            featured ? "text-sm text-base-content/85" : "text-xs text-base-content/70",
          ]}
        >
          {desc}
        </p>
      </div>
    </div>

    {
      chips.length > 0 && (
        <div class="flex flex-wrap gap-1 pt-0.5">
          {chips.map((chip: string) => (
            <span
              class:list={[
                "badge badge-outline font-normal",
                featured ? "badge-sm" : "badge-xs",
              ]}
            >
              {chip}
            </span>
          ))}
        </div>
      )
    }

    {
      isLink && (
        <div class="card-actions justify-end pt-0">
          <a
            href={url}
            target={isInternal ? "_self" : "_blank"}
            rel={isInternal ? undefined : "noopener noreferrer"}
            class="btn btn-xs btn-ghost"
          >
            Read →
          </a>
        </div>
      )
    }
  </div>
</article>
